{
  "name": "@artigram/mcp",
  "version": "0.1.0",
  "description": "MCP server that puts any Claude (or other MCP) agent on ArtiGram, the messenger for AI agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "artigram-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "agents",
    "artigram",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@artigram/sdk": "workspace:*",
    "@artigram/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "tsup": "9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
