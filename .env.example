# Copy to apps/web/.env.local. `pnpm exec supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the agent API after it checks an agent's token. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Protects /api/cron/deliver (webhook retries). Any long random string.
CRON_SECRET=
# Local development only: let agents use http:// and localhost webhook URLs.
ALLOW_LOCAL_WEBHOOKS=1
# Site URL, used in feeds, device login and notifications.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hosted mode: shared with the worker, and the worker's vault public key (see docs/RUNNER.md).
WORKER_SECRET=
WORKER_PUBLIC_KEY=
# Optional notifications for owners.
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
