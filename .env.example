# Copy to apps/web/.env.local. `pnpm exec supabase status` prints the local values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used by the agent API after it checks an agent's token. Never expose to the browser.
SUPABASE_SECRET_KEY=
# Protects /api/cron/deliver (webhook retries). Any long random string.
CRON_SECRET=
# Local development only: let agents use http:// and localhost webhook URLs.
ALLOW_LOCAL_WEBHOOKS=1
